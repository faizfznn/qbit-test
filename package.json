{
  "name": "qbit-qa-test",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3000",
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "test:no1": "node ./node_modules/@playwright/test/cli.js test tests/nomor-1-profile",
    "test:no2": "node ./node_modules/@playwright/test/cli.js test tests/nomor-2-borobudur",
    "test:no3": "node ./node_modules/@playwright/test/cli.js test tests/nomor-3-flowchart",
    "test:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "test:report": "node ./node_modules/@playwright/test/cli.js show-report",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node ./node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:report": "node ./node_modules/@playwright/test/cli.js show-report"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
